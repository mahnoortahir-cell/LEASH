# Copy this file to ".env" and fill it in. NEVER commit ".env" to GitHub (it is in .gitignore).

# From https://developer.paypal.com -> Apps & Credentials -> choose "Sandbox" -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leash only talks to the PayPal SANDBOX (fake money). Leave this line as it is.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: lets Leash use Claude to understand plain-English rules and draft dispute statements.
# Without it, Leash uses a simple rule reader and a template. Everything still works.
ANTHROPIC_API_KEY=
# LEASH_MODEL=claude-sonnet-5-5

# Optional but recommended: a secret that signs every audit-log entry, so the log cannot be
# rebuilt by someone who does not know it. Keep it safe; you need it to verify the log later.
LEASH_AUDIT_KEY=

# Optional OpenAI-compatible AI provider
LEASH_AI_API_KEY=
LEASH_AI_BASE_URL=https://api.groq.com/openai/v1
LEASH_AI_MODEL=openai/gpt-oss-120b
